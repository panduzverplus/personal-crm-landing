---
// min-height is for the content box, as in the design: the card is 220px + padding tall
const card = "rounded-card border border-peach p-18 md:box-content md:min-h-220 md:p-28";
---

<section aria-labelledby="features-title" class="bg-ink text-peach">
  <div class="mx-auto flex max-w-1440 flex-col gap-28 px-22 pt-56 pb-64 md:gap-48 md:px-56 md:pt-96 md:pb-120">
    <h2 id="features-title" class="border-t border-peach pt-14 text-h2 font-light md:pt-16">Удобно</h2>
    <ul class="flex flex-col gap-12 md:grid md:grid-cols-3 md:gap-16">
      <li class:list={[card, "flex flex-col gap-14 md:justify-between md:gap-24"]}>
        <p class="text-feature text-pretty">Поиск по запросу «петр иванов» найдёт «Иванов Пётр»</p>
        <div aria-hidden="true" class="flex flex-wrap items-center gap-10 font-ui text-chip">
          <span class="rounded-full bg-peach px-12 py-7 text-ink md:px-14 md:py-8">петр иванов</span>
          <span class="text-accent-on-dark">→</span>
          <span class="rounded-full border border-peach px-12 py-6 md:px-14 md:py-7">Иванов Пётр</span>
        </div>
      </li>
      <li class:list={[card, "text-feature text-pretty"]}>У заметок есть дата, новые сверху</li>
      <li class:list={[card, "text-feature text-pretty"]}>В любом браузере те же контакты</li>
    </ul>
  </div>
</section>
